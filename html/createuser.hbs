<html>

  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=utf-8' />
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css'
    />
    <!-- CSS only -->
    <link
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
      integrity='sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx'
      crossorigin='anonymous'
    />
    <style>
      body { margin: 0; padding: 0; font-family: Arial; background: #fff; } td
      span.dot_class { margin: 0; color: #ed5a24; border: 1px solid; } .font_fam
      { font-family: system, "Segoe UI", Tahoma; } .td { padding: 5px;
      text-align: left; width: 100px; background: #eaeaea9c; }
    </style>
  </head>

  <body>
    <table
      width='780'
      border='0'
      cellspacing='0'
      cellpadding='0'
      align='center'
      style='border: 1px solid #ccc;'
    >
      <tr>
        <td height='4' style='background:black;'></td>
      </tr>
      <tr>
        <td>
          <table width='100%' border='0' cellspacing='0' cellpadding='0'>
            <tr>
              <td width='60'>&nbsp;</td>
              <td>
                <table width='100%' border='0' cellspacing='0' cellpadding='0'>
                  <tr>
                    <td>
                      <table
                        width='100%'
                        border='0'
                        cellspacing='0'
                        cellpadding='0'
                      >
                        <tr>
                          <td colspan='2' height='40'>&nbsp;</td>
                        </tr>
                        <tr>
                          <td style="font-size: 30px;color:#fcba4b">{{ProjectName}}</td>
                          <td
                            align='right'
                            valign='middle'
                            style='font-family:Arial; font-size:18px; color:#fcba4b; line-height:28px;'
                          ><br /><a
                              href='mailto:repdoor@gmail.com'
                              style='font-family:Arial; color:#000; text-decoration:none;'
                            ></a>

                          </td>
                        </tr>
                        <tr>
                          <td colspan='2' height='40'>&nbsp;</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <td height='33'>&nbsp;</td>
                  </tr>
                  <tr>
                    <td
                      style='font-family:Arial; font-size:14px; color:#444; line-height:18px;'
                    >
                      Dear Sir/Mam,<br /><br />
                      Thank you for contacting {{ProjectName}}.
                      <br /><br />
                      We have successfully created your account.Please check
                      below email id and password on {{ProjectName}} website.
                      <br /><br />

                      <h3>Login Details
                        <hr />
                      </h3>
                      <table border='1px'>
                        <tr>
                          <td class='td'><b>Mobile No</b></td>
                          <td class='td' style=' width: 250px;'>
                            {{user_email}}
                          </td>
                        </tr>
                        <tr>
                          <td class='td'><b>Password</b></td>
                          <td class='td' style=' width: 250px;'>
                            {{user_password}}
                          </td>
                        </tr>

                      </table>

                      <br /><br />
                      <b>Best Regards,<br />
                        Team {{ProjectName}}</b>

                    </td>
                  </tr>
                  <tr>
                    <td height='35'>&nbsp;</td>
                  </tr>

                  <tr>
                    <td height='55'>&nbsp;</td>
                  </tr>

                </table>
              </td>
              <td width='60'>&nbsp;</td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td height='40' style='background:black;'>

          <span style='padding-left: 60px;'>
            <a href='' style='color:#fff;text-decoration: none;'> </a>
          </span>

          <!--span style='padding-right: 60px;float: right;color: #fff;'>
                      <i class="fa fa-facebook-official" aria-hidden="true"></i>
                      <i class="fa fa-twitter-square" aria-hidden="true"></i>
                      <i class="fa fa-linkedin-square" aria-hidden="true"></i>
                      <i class="fa fa-google-plus-square" aria-hidden="true"></i>
                    </span-->

        </td>
      </tr>
    </table>
  </body>

</html>