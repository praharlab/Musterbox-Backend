<html lang='en'>

  <head>
    <link rel='stylesheet' href='./bootstrap.css' />
    <title>
      Salary register With Date Of Pay
    </title>
    <style>
      body { margin: 20px; } */ .table { page-break-inside: auto; } .table tr {
      page-break-inside: avoid; } .table td { page-break-inside: avoid; } tr {
      page-break-inside: avoid !important; } .table th, .table td {
      border-color: black !important; } .border { border: 1px solid black
      !important; } th, td { font-size: 8px; text-wrap: wrap; white-space: wrap;
      } .vertical-text { writing-mode: vertical-lr; }
    </style>
  </head>

  <body>
    <div>
      <div style='text-align: center;'>
        <h3
          style='margin-bottom: 0px !important;'
        >{{headingData.companyName}}</h3>
        <div>
          <span style='font-size: 14px;'>{{headingData.companyAddress}}</span>
          <span style='float: right;'>{{headingData.month}}</span></div>

        {{#if headingData.branchName}}
          <span style='font-size: 14px;'>
            {{headingData.branchName}},
            {{headingData.branchAddress}}</span>
        {{/if}}
      </div>

      <div style='margin-bottom : 20px;'>
        {{#if (and (gt datalength 30))}}
          <table
            border='1'
            style='border-collapse: collapse;table-layout: fixed;width: 1100px !important;'
          >
            <tr>
              {{#each keysArray}}
                <th class='vertical-text'>{{this}}</th>
              {{/each}}
            </tr>
            {{#each finaldata}}
              <tr>
                {{#forIn this}}
                  <td
                    style='text-align: center;'
                    class='vertical-text'
                  >{{value}}</td>
                {{/forIn}}
              </tr>
            {{/each}}
          </table>

        {{/if}}

        {{#if (and (lte datalength 30))}}
          <table
            border='1'
            style='border-collapse: collapse;table-layout: fixed;width: 1100px !important;'
          >
            <tr>
              {{#each keysArray}}
                <th>{{this}}</th>
              {{/each}}
            </tr>
            {{#each finaldata}}
              <tr>
                {{#forIn this}}
                  <td style='text-align: center;'>{{value}}</td>
                {{/forIn}}
              </tr>
            {{/each}}
          </table>

        {{/if}}

      </div>

    </div>

    <script src='./bootstrap.js'></script>
    <script src='./jquery.js'></script>
    <script src='./popper.js'></script>
  </body>

</html>