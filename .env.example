# Copy to .env and fill in. Never commit .env — it is gitignored.
# Values are read via process.env.X or dotenv.parsed.X depending on the module.

# ----------------------------- Database -----------------------------
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_DIALECT=postgres
# DB_PORT is currently not read by any code; the pg driver defaults to 5432.
DB_PORT=5432

# ----------------------------- Auth / crypto -----------------------------
# JWT signing key. Changing it invalidates all live tokens (users re-login).
SECRETKEY=
# HMAC key for signData()/verifyData() in utils/commonUtilFunctions.js
PASSWORD=
# Marker used by encodeSecureBreak()/decodeSecureFix()
SECRETKEYFORENCODING=
# Not read by any code. bcrypt generates a per-hash salt.
SALT=

# ----------------------------- Application -----------------------------
# Public base URL of this API, with trailing slash. Used to build file URLs.
APIURL=
NODE_ENV=development

# ----------------------------- Branding / tenant -----------------------------
# These replace the commented-out per-tenant blocks in utils/labelUtils.js.
PROJECT_NAME=
# Frontend base URL, with trailing slash.
APP_URL=
# Optional. Defaults to "${APP_URL}#/user/preboarding/" when left blank.
PREBOARDING_APP_URL=
# Booleans: "true" or "false" (anything else is treated as false).
CONVERT_NAME_TO_LOCAL_NAME=false
PIH_MOBILE_VALIDATION=false
SHOW_PAYROLL_FREQUENCY=false
OTHER_NUMBER_LABEL=Other Contact Number

# ----------------------------- Mail -----------------------------
HOSTMAIL=
USEREMAIL=
PASS=
# Not read by any code.
SERVICE=
# Referenced in code but was absent from .env — mail may silently misbehave.
SMTPUSEREMAIL=

# ----------------------------- Face recognition -----------------------------
FACE_API_URL=

# ----------------------------- eTimeOffice biometric API -----------------------------
# Base URL, no trailing slash.
ETIMEOFFICE_BASE_URL=https://api.etimeoffice.com
# Basic-auth username in the form corpid:username:password:true
ETIMEOFFICE_INOUT_AUTH=
ETIMEOFFICE_INOUT_PASSWORD=
ETIMEOFFICE_LASTPUNCH_AUTH=
ETIMEOFFICE_LASTPUNCH_PASSWORD=

# ----------------------------- FAS report API -----------------------------
FAS_API_URL=

# ----------------------------- ERP (MSSQL) -----------------------------
# Read via dotenv.parsed in config/erpdatabase.js. Leave blank if unused.
ERP_SERVER=
ERP_PORT=
ERP_USER=
ERP_PASSWORD=
ERP_DATABASE=

# ----------------------------- Biometric DB (MSSQL) -----------------------------
# Read via dotenv.parsed in config/biometricIntegrationdb.js. Leave blank if unused.
BIOMETRICS_SERVER=
BIOMETRICS_PORT=
BIOMETRICS_USER=
BIOMETRICS_PASSWORD=
BIOMETRICS_DATABASE_SELF=
BIOMETRICS_DATABASE_THIRD_PARTY=

# ----------------------------- Firebase (push notifications) -----------------------------
# Resolved in config/firebase.js. Inline JSON wins; otherwise the path is used;
# otherwise ./firebase_privateKey.json is tried. If none resolve, the server
# still boots and push notifications are skipped with a warning.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase_privateKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Only set these when iOS uses a SEPARATE Firebase project. Left blank, iOS
# reuses the credential above.
FIREBASE_IOS_SERVICE_ACCOUNT_PATH=
# FIREBASE_IOS_SERVICE_ACCOUNT_JSON=

# ----------------------------- Third-party keys -----------------------------
WINSTON_API_KEY=
# Not read by any code.
GOOGLE_MAPS_KEY=

# ----------------------------- Referenced in code but never defined -----------------------------
# These are read somewhere in the codebase but were missing from .env, so they
# evaluate to undefined at runtime today. Fill them in if you need the feature,
# otherwise delete both the variable and the code path that reads it.
PROJAPIURL=
PROJAPIKEY=
GOOGLE_CLOUD_TRANSLATE_API_KEY=
MARS_FORGOT_OTP_API=
MARS_FORGOT_OTP_API_KEY=
MARS_FORGOT_OTP_CTID=
MARS_FORGOT_OTP_PEID=
